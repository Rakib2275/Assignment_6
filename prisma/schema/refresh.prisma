model RefreshToken {
  id String @id @default(uuid())

  token String @unique

  userId String

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  // User relation
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}
