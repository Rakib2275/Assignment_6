model OutageReport {
  id            String         @id @default(uuid())
  title         String
  description   String?

  type          OutageType     @default(UNEXPECTED)
  status        OutageStatus   @default(REPORTED)
  priority      Priority @default(MEDIUM)

  areaId        String
  reportedById  String

  reportedAt   DateTime  @default(now())
  verifiedAt   DateTime?
  assignedAt   DateTime?
  startedAt    DateTime?
  restoredAt   DateTime?
  closedAt     DateTime?

  area          Area @relation(fields: [areaId], references: [id])
  reportedBy    User @relation(fields: [reportedById], references: [id])

  assignments   TechnicianAssignment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([areaId])
  @@index([reportedById])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([reportedAt])
}
